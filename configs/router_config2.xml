<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
  <native xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-native">
    <hostname>NETCONF-R1</hostname>
    
    <interface>
      <GigabitEthernet>
        <name>1</name>
        <description>WAN Interface</description>
        <ip>
          <address>
            <primary>
              <address>192.168.56.10</address>
              <maskitem>255.255.255.0</maskitem>
            </primary>
          </address>
        </ip>
      </GigabitEthernet>

      <Loopback>
        <name>0</name>
        <ip>
          <address>
            <primary>
              <address>10.10.10.1</address>
              <maskitem>255.255.255.0</maskitem>
            </primary>
          </address>
        </ip>
      </Loopback>
    </interface>

    <router>
      <ospf xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-ospf">
        <process-id>
          <id>1</id>
          <network>
            <number>192.168.56.0</number>
            <wildcard>0.0.0.255</wildcard>
            <area>0</area>
          </network>
          <network>
            <number>10.10.10.0</number>
            <wildcard>0.0.0.255</wildcard>
            <area>0</area>
          </network>
        </process-id>
      </ospf>
    </router>

  </native>
</config>

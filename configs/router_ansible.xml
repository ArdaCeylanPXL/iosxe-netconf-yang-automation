<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
  <native xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-native">
    <hostname>ANSIBLE-NETCONF-R1</hostname>
    
    <interface>
      <GigabitEthernet>
        <name>1</name>
        <description>WAN Interface via Ansible</description>
        <ip>
          <address>
            <primary>
              <address>192.168.56.10</address>
              <maskitem>255.255.255.0</maskitem>
            </primary>
          </address>
        </ip>
      </GigabitEthernet>

      <Loopback>
        <name>0</name>
        <description>Loopback via Ansible</description>
        <ip>
          <address>
            <primary>
              <address>10.10.10.1</address>
              <maskitem>255.255.255.0</maskitem>
            </primary>
          </address>
        </ip>
      </Loopback>
    </interface>

    <router>
      <ospf xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-ospf">
        <id>1</id>
        <network>
          <ip>192.168.56.0</ip>
          <mask>0.0.0.255</mask>
          <area>0</area>
        </network>
        <network>
          <ip>10.10.10.0</ip>
          <mask>0.0.0.255</mask>
          <area>0</area>
        </network>
      </ospf>
    </router>

  </native>
</config>
